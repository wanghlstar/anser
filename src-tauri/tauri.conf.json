{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "雁信",
  "version": "0.2.2",
  "identifier": "dev.maildesk.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "雁信",
        "width": 1380,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 650,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "capabilities": ["main", "mail-window", "compose-window"],
      "csp": "default-src 'self'; img-src 'self' data: blob: http: https:; font-src 'self' data: https:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "infoPlist": "Info.plist"
    },
    "createUpdaterArtifacts": true,
    "fileAssociations": [
      {
        "ext": ["eml"],
        "name": "EML 邮件文件",
        "mimeType": "message/rfc822",
        "contentTypes": ["com.apple.mail.email"],
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "resources": {
      "../LICENSE": "LICENSE",
      "../NOTICE": "NOTICE",
      "../docs/LICENSING.md": "LICENSING.md",
      "../docs/licenses/shadcn-ui-MIT.txt": "licenses/shadcn-ui-MIT.txt"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDczNUJFMzZGRjQ5RDE5RDEKUldUUkdaMzBiK05iYyszUjRmVU9wQVJRdjk4Y0R3bmo4Zm9PenprTUpyR2sxSUxCTzhBVnQ3RDkK",
      "endpoints": [
        "https://github.com/wanghlstar/anser/releases/latest/download/latest.json"
      ]
    }
  }
}
